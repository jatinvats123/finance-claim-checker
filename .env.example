# Only needed for --mode live / --mode record. The keyless demo (npm start) needs nothing.
# Set ONE provider key; the model is picked from it (override with CHECKER_MODEL or --model).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# CHECKER_MODEL=claude-sonnet-5-5
# For browser runs and rechecks, set this to the provider project's request-per-minute limit.
# CHECKER_WEB_RPM=30

# Only needed to refresh SEC data (npm run snapshot:sec / --live-sec). SEC asks for a contact.
# SEC_USER_AGENT="Your Name you@example.com"
